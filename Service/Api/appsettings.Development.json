{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FastEndpoints": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "RootPath": "../../_docker/volumes/orchestrator/server",
    "TraefikNetwork": "traefik-proxy",
    // Docker daemon endpoint used by Docker.DotNet and as DOCKER_HOST for CLI sub-processes.
    //
    // Linux / Docker container (docker-compose.yml bind-mount: /var/run/docker.sock:/var/run/docker.sock):
    //"DockerHostUri": "unix:///var/run/docker.sock"
    //
    // Windows – local development with Docker Desktop (run via Visual Studio, not in container):
    "DockerHostUri": "npipe://./pipe/docker_engine"
  },
  "Keycloak": {
    "Host": "http://localhost:9345",
    "Realm": "gaeco",
    "ClientId": "app-orchestrator"
  },
  "Postgres": {
    "Host": "localhost",
    "Port": "6433",
    "User": "apporchestratoruser",
    "Password": "AppOrchestratorPassw0rd!",
    "Database": "apporchestratordb"
  }
}
