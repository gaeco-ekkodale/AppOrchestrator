<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<UserSecretsId>71a41eca-021d-45b5-9123-0ad9c694b1cd</UserSecretsId>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Shared\Mappings\**" />
    <Compile Remove="Shared\Validation\**" />
    <Content Remove="Shared\Mappings\**" />
    <Content Remove="Shared\Validation\**" />
    <EmbeddedResource Remove="Shared\Mappings\**" />
    <EmbeddedResource Remove="Shared\Validation\**" />
    <None Remove="Shared\Mappings\**" />
    <None Remove="Shared\Validation\**" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Docker.DotNet" Version="3.125.15" />
	<PackageReference Include="FastEndpoints" Version="5.27.0" /> 
	<PackageReference Include="FastEndpoints.Swagger" Version="5.27.0" />
	<PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.22" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.2" />
	<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.2" />
	<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
	<PackageReference Include="YamlDotNet" Version="16.3.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
		<PrivateAssets>all</PrivateAssets>
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Infrastructure\AppOrchestrator.Infrastructure.csproj" />
  </ItemGroup>
</Project>
