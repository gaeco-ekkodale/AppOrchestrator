# =============================================================================
# AppOrchestrator - local docker environment
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# IMAGE_BASE_PATH points at the Gaeco Azure Container Registry - log in with
# `az acr login --name crgaeco001` (or change it to your own registry) before the first start.
#
# Keycloak: this module uses two clients - the confidential backend client
# (KEYCLOAK_SERVER_CLIENT_ID) and the public browser client the frontend logs in
# with (KEYCLOAK_CLIENT_CLIENT_ID). Locally auth is switched off entirely
# (Auth__Enabled=false / VITE_AUTH_DISABLED=true in docker-compose-override.yml),
# so neither client has to exist for a local start.
# See Gaeco/_docu/developer/keycloak/own-keycloak-client.md
#
# Available environment files:
#   - .env         : this file, local development (with docker-compose-override.yml)
#   - .env.server  : production/server deployment (with docker-compose.server.yml)
#
# Usage:
#   Local:  docker compose -f docker-compose.yml -f docker-compose-override.yml up
#   Server: docker compose --env-file .env.server -f docker-compose.server.yml up
# =============================================================================

# ============================================================================
# PROTOCOL CONFIGURATION
# ============================================================================
# Protocol used for all external URLs (http for local, https for production)
PROTOCOL=http

# ============================================================================
# 1. INFRASTRUCTURE SERVICES
# ============================================================================

# --- PostgreSQL for Application Orchestrator ---
ORCHESTRATOR_POSTGRES_DATABASE=apporchestratordb
ORCHESTRATOR_POSTGRES_USER=apporchestratoruser
ORCHESTRATOR_POSTGRES_PASSWORD=AppOrchestratorPassw0rd!

# ============================================================================
# 2. AUTHENTICATION SERVICES
# ============================================================================

# --- Keycloak Server ---
KEYCLOAK_SERVER_HOSTNAME=localhost:9345
KEYCLOAK_REALM=gaeco

# --- Backend: confidential client (service account, has a secret)
KEYCLOAK_SERVER_CLIENT_ID=app-orchestrator

# --- Frontend: public client used for the browser login
KEYCLOAK_CLIENT_CLIENT_ID=orchestrator-client

# ============================================================================
# 3. APPLICATION SERVICES
# ============================================================================

# --- App Orchestrator Backend API ---
ORCHESTRATOR_SERVER_TAG=latest
ORCHESTRATOR_SERVER_HOSTNAME=localhost:6241

# --- App Orchestrator Frontend Client ---
ORCHESTRATOR_CLIENT_TAG=latest
ORCHESTRATOR_CLIENT_HOSTNAME=localhost:3000
MOUNT_ROUTE=/orchestrator

# ============================================================================
# GENERAL CONFIGURATION
# ============================================================================
STACK_NAME=orchestrator
ENVIRONMENT_NETWORK=gaeco-local
TRAEFIK_NETWORK=traefik-proxy
ASPNETCORE_ENVIRONMENT=Development
VOLUME_BASE_PATH=./volumes
IMAGE_BASE_PATH=crgaeco001.azurecr.io
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Override (Port-Bindings)
ORCHESTRATOR_POSTGRES_OUTERPORT=6433
ORCHESTRATOR_SERVER_OUTERPORT=6241
ORCHESTRATOR_CLIENT_OUTERPORT=3000
