# ============================================================================
# Server/Production Environment Configuration
# ============================================================================
# This configuration is used for production deployment with Traefik.
# 
# IMPORTANT: Update all domain names before deployment!
#   - KEYCLOAK_SERVER_HOSTNAME
#   - ORCHESTRATOR_SERVER_HOSTNAME
#
# Usage:
#   docker compose --env-file .env.server -f docker-compose.server.yml up -d
# ============================================================================

# ============================================================================
# PROTOCOL CONFIGURATION
# ============================================================================
# Protocol used for all external URLs (http for local, https for production)
PROTOCOL=https

# ============================================================================
# 1. INFRASTRUCTURE SERVICES
# ============================================================================

# --- PostgreSQL for Application Orchestrator ---
ORCHESTRATOR_POSTGRES_DATABASE=apporchestratordb
ORCHESTRATOR_POSTGRES_USER=apporchestratoruser
ORCHESTRATOR_POSTGRES_PASSWORD=CHANGE_ME

# --- PostgreSQL for Keycloak ---
KEYCLOAK_POSTGRES_DATABASE=keycloakdb
KEYCLOAK_POSTGRES_USER=keycloakuser
KEYCLOAK_POSTGRES_PASSWORD=CHANGE_ME

# ============================================================================
# 2. AUTHENTICATION SERVICES
# ============================================================================

# --- Keycloak Server ---
KEYCLOAK_SERVER_HOSTNAME=auth.example.invalid
KEYCLOAK_REALM=orchestrator

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Backend: confidential client (service account, has a secret)
KEYCLOAK_SERVER_CLIENT_ID=app-orchestrator

# --- Frontend: public client used for the browser login
KEYCLOAK_CLIENT_CLIENT_ID=orchestrator-client

# ============================================================================
# 3. APPLICATION SERVICES
# ============================================================================

# --- App Orchestrator Backend API ---
ORCHESTRATOR_SERVER_TAG=latest
ORCHESTRATOR_SERVER_HOSTNAME=api.example.invalid

# --- App Orchestrator Frontend Client ---
ORCHESTRATOR_CLIENT_TAG=latest
ORCHESTRATOR_CLIENT_HOSTNAME=app.example.invalid
MOUNT_ROUTE=/orchestrator

# ============================================================================
# GENERAL CONFIGURATION
# ============================================================================
STACK_NAME=orchestrator
TRAEFIK_NETWORK=traefik-proxy
ASPNETCORE_ENVIRONMENT=Production
VOLUME_BASE_PATH=./volumes
IMAGE_BASE_PATH=registry.example.invalid/apporchestrator
DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
